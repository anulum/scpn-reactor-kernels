# SCPN Reactor Kernels — local gate entry points

VENV := .venv/bin
PYTHON := $(VENV)/python

.PHONY: venv lock lint typecheck test validate rust docs preflight

# Hash-locked install sets. `make lock` regenerates every requirements-*.txt
# from its lock input and pyproject.toml for the CI interpreter; CI installs
# them with --require-hashes.
LOCK := uv pip compile --quiet --generate-hashes --python-version 3.12 --python-platform x86_64-manylinux_2_31
LOCK_HEAD := sed -n '1,6p' requirements-dev.in
LOCK_TITLE := $(shell sed -n '7s/^\# \(.*\) — .*/\1/p' requirements-dev.in)

venv:
	python3 -m venv .venv
	$(VENV)/pip install --require-virtualenv --require-hashes -r requirements-cad.txt
	$(VENV)/pip install --require-virtualenv --no-deps -e .

lock:
	{ $(LOCK_HEAD); echo "# $(LOCK_TITLE) — development toolchain lock (generated by make lock)"; \
	  $(LOCK) requirements-dev.in pyproject.toml; } > requirements-dev.txt
	{ $(LOCK_HEAD); echo "# $(LOCK_TITLE) — development toolchain with the CAD extra lock (generated by make lock)"; \
	  $(LOCK) requirements-dev.in pyproject.toml --extra cad -c requirements-dev.txt; } > requirements-cad.txt
	{ $(LOCK_HEAD); echo "# $(LOCK_TITLE) — audit and inventory tooling lock (generated by make lock)"; \
	  $(LOCK) requirements-audit.in; } > requirements-audit.txt

lint:
	$(VENV)/ruff check .
	$(VENV)/ruff format --check .

typecheck:
	$(VENV)/mypy --strict src tools tests benchmarks

test:
	$(VENV)/pytest -q --cov=src --cov=tools --cov-branch --cov-fail-under=100

validate:
	$(PYTHON) tools/validate_kernels_domain.py kernels-domain.json
	$(PYTHON) tools/generate_kernel_inventory.py --check

rust:
	cd rust && cargo fmt --check && cargo clippy --all-targets --features python -- -D warnings && cargo doc --no-deps --features python && cargo test

docs:
	$(PYTHON) tools/preflight.py --only docs

preflight:
	$(PYTHON) tools/preflight.py
